# ========================================================
# MongoDB Atlas & Vercel Environment Configuration
# ========================================================
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/thefooder?retryWrites=true&w=majority

# Name of the database to use inside MongoDB Atlas
MONGODB_DB=thefooder

# Optional: Server Port for local testing
PORT=3000
